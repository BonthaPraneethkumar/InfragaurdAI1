# REQUIRED FOR REAL VOICE -> ENGLISH AND AI TRIAGE
SARVAM_API_KEY=

# Sarvam current speech model. v4 supports 22 Indian languages + English.
SARVAM_STT_MODEL=saaras:v4
SARVAM_CHAT_MODEL=sarvam-105b

# OPTIONAL: converts GPS coordinates into a readable address.
AZURE_MAPS_KEY=

# If true, text triage continues with local fallback if Sarvam is unavailable.
APP_DEMO_FALLBACK=true
