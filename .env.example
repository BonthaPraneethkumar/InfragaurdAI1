# REQUIRED FOR REAL VOICE -> ENGLISH AND AI TRIAGE
SARVAM_API_KEY=

# Sarvam current speech model. v4 supports 22 Indian languages + English.
SARVAM_STT_MODEL=saaras:v3
SARVAM_CHAT_MODEL=sarvam-105b

# OPTIONAL: converts GPS coordinates into a readable address.
AZURE_MAPS_KEY=

# If true, text triage continues with local fallback if Sarvam is unavailable.
APP_DEMO_FALLBACK=true

# General-image analysis through Sarvam /v2 beta (Gemma 4).
# If your API key is not whitelisted for beta, the app falls back to local visual cues + voice/text.
SARVAM_VISION_MODEL=gemma4
SARVAM_VISION_ENABLED=true

# Privacy-first mode: aggressive redaction plus fail-closed verification.
PRIVACY_STRICT=true
